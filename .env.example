NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
# Per-request timeout in seconds; SDK retries are disabled.
NVIDIA_REQUEST_TIMEOUT_SECONDS=10
# Total CLI evaluation deadline; keeps CI bounded even with retries.
EVALUATION_TIMEOUT_SECONDS=900
# Optional sampling controls for reproducible runs.
NVIDIA_TEMPERATURE=
NVIDIA_SEED=
# HTTP API (documented in docs/architecture/ADR-0003-api-and-runner.md).
# Token required for mutating endpoints; >=12 characters; leave empty
# only for truly local use (readiness will warn).
API_TOKEN=
# Comma-separated origins allowed to call the API from a browser.
API_CORS_ORIGINS=http://localhost:5173
# Max simultaneous pipeline executions (each run awaits its provider).
API_MAX_CONCURRENT_RUNS=1
# Slack drift alerts (Incoming Webhook).
# SLACK_WEBHOOK_URL is a secret; never expose it through APIs or logs.
# Leave the webhook URL empty to keep Slack unconfigured (no messages).
SLACK_WEBHOOK_URL=
SLACK_NOTIFICATIONS_ENABLED=true
# Bounded webhook delivery: request timeout and total attempt count.
SLACK_TIMEOUT_SECONDS=10
SLACK_MAX_ATTEMPTS=3
# Optional dashboard base URL; drift alerts then link {prefix}/runs/{id}.
SLACK_REPORT_URL_PREFIX=
DATABASE_URL=sqlite:///promptguard.db
