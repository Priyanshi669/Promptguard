NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
# Per-request timeout in seconds; SDK retries are disabled.
NVIDIA_REQUEST_TIMEOUT_SECONDS=10
# Total CLI evaluation deadline; keeps CI bounded even with retries.
EVALUATION_TIMEOUT_SECONDS=900
# Optional sampling controls for reproducible runs.
NVIDIA_TEMPERATURE=
NVIDIA_SEED=
# HTTP API (documented in docs/architecture/ADR-0003-api-and-runner.md).
# Token required for mutating endpoints; >=12 characters; leave empty
# only for truly local use (readiness will warn).
API_TOKEN=
# Comma-separated origins allowed to call the API from a browser.
API_CORS_ORIGINS=http://localhost:5173
# Max simultaneous pipeline executions (each run awaits its provider).
API_MAX_CONCURRENT_RUNS=1
SLACK_WEBHOOK_URL=
DATABASE_URL=sqlite:///promptguard.db
