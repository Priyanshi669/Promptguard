{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PromptGuard judge calibration dataset",
  "description": "Human-labelled summary pairs with rubric and dataset identity. Example IDs must be unique and the rubric version/hash must match the current rubric.",
  "type": "object",
  "properties": {
    "metadata": {
      "$ref": "#/$defs/CalibrationDatasetMetadata"
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/JudgeCalibrationExample"
      }
    }
  },
  "required": [
    "metadata",
    "examples"
  ],
  "$defs": {
    "CalibrationDatasetMetadata": {
      "title": "CalibrationDatasetMetadata",
      "description": "Version and rubric identity required for calibration evidence.",
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "rubric_version": {
          "type": "string",
          "minLength": 1
        },
        "rubric_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "version",
        "rubric_version",
        "rubric_sha256"
      ]
    },
    "JudgeCalibrationExample": {
      "title": "JudgeCalibrationExample",
      "description": "One human-labelled summary pair used to calibrate the judge.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "expected_summary": {
          "type": "string",
          "minLength": 1
        },
        "actual_summary": {
          "type": "string",
          "minLength": 1
        },
        "human_score": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "id",
        "expected_summary",
        "actual_summary",
        "human_score"
      ]
    }
  }
}
